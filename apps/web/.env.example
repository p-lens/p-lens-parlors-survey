# Where the list's JSONL files are published, ending in a slash.
# `bun run dev-list <dataset>` writes a local copy to public/list/.
VITE_LIST_URL=/list/

# Where p-lens-brokers' observations.jsonl is published, ending in a slash: the
# brokers' names already given are offered from it. Left empty, none is offered.
VITE_BROKERS_URL=https://brokers.p-lens.jp/

# Cloudflare Turnstile site key; leave empty to show no challenge.
VITE_TURNSTILE_SITE_KEY=

# The origins a person may be sent here from and taken back to with the id of
# what they reported, separated by commas (https://app.p-lens.jp). Left empty,
# nobody is taken anywhere.
VITE_CALLER_ORIGINS=
