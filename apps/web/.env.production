# What the published page is built with. Neither value is a secret: both are
# sent to every browser that opens the page.

# Where the list's JSONL files are published, ending in a slash.
VITE_LIST_URL=https://parlors.p-lens.jp/

# Where p-lens-brokers' observations.jsonl is published, ending in a slash: the
# brokers' names already given are offered from it. Left empty, none is offered.
VITE_BROKERS_URL=https://brokers.p-lens.jp/

# The Cloudflare Turnstile site key. The server takes no report without a
# Turnstile token, so the published page must have one.
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAFPVEKobjPEhzYGB

# The origins a person may be sent here from and taken back to with the id of
# what they reported, separated by commas.
VITE_CALLER_ORIGINS=https://app.p-lens.jp
